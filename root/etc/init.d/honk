#!/bin/sh /etc/rc.common
# shellcheck shell=busybox
USE_PROCD=1
START=99
STOP=01
PROG=/usr/bin/honk-core

start_service() {
	local conffile
	# APK install hooks may start every init script. First installation must
	# stay disabled; package upgrades only restart an explicitly enabled service.
	if [ "${pkgname:-}" = luci-app-honk ]; then
		if [ "$PKG_UPGRADE" != 1 ]; then disable; return 0; fi
		enabled || return 0
	fi
	[ -x "$PROG" ] || { logger -t honk 'Core binary is missing; reinstall luci-app-honk'; return 1; }
	# dae uses the same eBPF interfaces and network namespace.
	if [ -x /etc/init.d/dae ]; then
		local dae_state
		dae_state=$(ubus call service list '{"name":"dae"}') || return 1
		if jsonfilter -s "$dae_state" -e '@.dae.instances.*.running' | grep -qx true; then
			logger -t honk 'dae is running; stop it before starting honk'; return 1
		fi
	fi
	local release major minor
	release=$(uname -r); major=${release%%.*}; minor=${release#*.}; minor=${minor%%.*}
	[ "$major" -gt 6 ] || { [ "$major" = 6 ] && [ "$minor" -ge 12 ]; } || {
		logger -t honk 'Linux 6.12 or newer is required'; return 1;
	}
	[ -r /sys/kernel/btf/vmlinux ] || [ -r /usr/lib/debug/boot/vmlinux ] || {
		logger -t honk 'Kernel BTF is missing'; return 1;
	}
	[ -r /sys/fs/cgroup/cgroup.controllers ] || { logger -t honk 'cgroup v2 is required'; return 1; }
	grep -qs ' /sys/fs/bpf bpf ' /proc/mounts || mount -t bpf bpf /sys/fs/bpf || return 1
	config_load honk
	config_get conffile main conffile /etc/honk/config.dae
	[ -r "$conffile" ] || return 1
	procd_open_instance main
	procd_set_param command "$PROG" --config "$conffile" --disable-timestamp
	procd_set_param user root
	procd_set_param file "$conffile"
	procd_set_param limits core='unlimited' nofile='1048576 1048576'
	procd_set_param term_timeout 30
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	local conffile state
	procd_running honk main || return 0
	config_load honk
	config_get conffile main conffile /etc/honk/config.dae
	state=$(ubus call service list '{"name":"honk"}') || return 1
	if jsonfilter -s "$state" -e '@.honk.instances.main.command[*]' | grep -qxF -- "$conffile"; then
		# The core locates its instance lock and signals that process with SIGHUP.
		"$PROG" reload
	else
		# procd replaces the instance when its command/configuration path changes.
		start
	fi
}

service_triggers() {
	procd_add_reload_trigger honk
}
