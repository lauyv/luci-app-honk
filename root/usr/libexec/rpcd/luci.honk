#!/bin/sh
# shellcheck shell=busybox
# shellcheck disable=SC1091
. /usr/share/libubox/jshn.sh
. /usr/share/honk-panel/common.sh
. /usr/share/honk-panel/download.sh
. /usr/share/honk-panel/geo.sh

reply() {
	json_init
	json_add_boolean ok "$1"
	json_add_string code "$2"
	json_add_string details "${3:-}"
	json_dump
}

queue_worker() {
	JOB_ID="$(date +%s)-$$"
	job queued operation_queued
	/usr/libexec/honk-panel-worker "$1" "${2:-}" "$JOB_ID" </dev/null >/dev/null 2>&1 &
	json_init
	json_add_boolean ok 1
	json_add_string code operation_queued
	json_add_string id "$JOB_ID"
	json_dump
}

case "$1" in
	list)
		printf '%s\n' '{"status":{},"read":{},"logs":{},"save":{"content":"String","revision":"String"},"action":{"name":"String","revision":"String"},"autostart":{"enabled":true},"geo":{"geosite_url":"String","geoip_url":"String"},"preferences":{"proxy":"String"}}'
		exit 0;;
	call) ;;
	*) exit 1;;
esac

prepare || { reply 0 'directories_failed' "$DETAILS"; exit 0; }
command -v flock >/dev/null 2>&1 || { reply 0 flock_missing; exit 0; }
case "$2" in

	status)
		config_error=''
		settings || config_error="$ERROR"
		pid=$(running_pid)
		boot=0
		"$INIT" enabled >/dev/null 2>&1 && boot=1
		busy=0
		if lock; then recover_job; unlock; else busy=1; fi
		job_data=$(cat "$RUN/job.json" 2>/dev/null)
		json_init
		json_add_boolean ok 1
		json_add_string error_code "$config_error"
		json_add_string version "$(run_timeout 2 "$BIN" --version 2>/dev/null | head -n 1)"
		json_add_string config "$CONFIG"
		json_add_string revision "$([ -z "$config_error" ] && config_revision)"
		json_add_string pid "$pid"
		json_add_boolean running "$([ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && echo 1 || echo 0)"
		json_add_boolean autostart "$boot"
		json_add_boolean busy "$busy"
		json_add_string job "$job_data"
		json_add_boolean core_installed "$([ -x "$BIN" ] && echo 1 || echo 0)"
		json_add_boolean rollback_available "$([ -x "$BACKUP" ] && echo 1 || echo 0)"
		json_add_string target "$(core_target)"
		json_add_string releases "$(cat "$RUN/releases.json" 2>/dev/null)"
		json_add_string proxy_prefix "$(core_proxy_prefix)"
		json_add_string geosite_url "$(geo_config_url geosite)"
		json_add_string geoip_url "$(geo_config_url geoip)"
		json_add_string environment "$(environment_report)"
		json_dump;;
	read)
		settings || { reply 0 "$ERROR"; exit 0; }
		if [ -f "$CONFIG" ] && [ "$(wc -c < "$CONFIG")" -gt "$MAX_SIZE" ]; then
			reply 0 config_too_large; exit 0
		fi
		revision=$(config_revision)
		content=$(cat "$CONFIG" 2>/dev/null; printf '.')
		content=${content%.}
		[ "$revision" = "$(config_revision)" ] || { reply 0 config_changed; exit 0; }
		json_init
		json_add_boolean ok 1
		json_add_string content "$content"
		json_add_string revision "$revision"
		json_dump;;
	logs)
		# Match the process tag, not arbitrary mentions elsewhere in the log.
		raw=$(run_timeout 3 logread -e 'honk' 2>/dev/null) || {
			reply 0 'logs_failed'; exit 0;
		}
		lines=$(printf '%s\n' "$raw" | grep -E 'honk(-core)?(\[[0-9]+\])?:' | tail -n 200 | tail -c 24576)
		json_init
		json_add_boolean ok 1
		json_add_string content "$lines"
		json_dump;;
	save)
		# jshn assigns these variables by name; initialize them for static analysis.
		kind='' content='' revision=''
		# JSON may encode each content byte as a six-byte Unicode escape.
		read_request "$((MAX_SIZE * 6 + 4096))" || { reply 0 request_invalid; exit 0; }
		json_get_type kind content
		[ "$kind" = string ] || { reply 0 content_invalid; exit 0; }
		json_get_var content content
		json_get_var revision revision
		[ "$(printf '%s' "$content" | wc -c)" -le "$MAX_SIZE" ] || { reply 0 config_too_large; exit 0; }
		lock || { reply 0 operation_busy; exit 0; }
		trap 'unlock' EXIT
		settings || { reply 0 "$ERROR"; exit 0; }
		if { [ -z "$revision" ] || [ "$revision" != "$(config_revision)" ]; }; then
			reply 0 config_changed; exit 0
		fi
		trap 'rm -f "$RUN/save.conf"; unlock' EXIT
		printf '%s' "$content" > "$RUN/save.conf" || { reply 0 config_save_failed; exit 0; }
		queue_worker save "$revision"
		trap - EXIT
		exit 0;;
	action)
		name='' revision=''
		read_request 1024 || { reply 0 'request_invalid'; exit 0; }
		json_get_var name name
		json_get_var revision revision
		case "$name" in start|stop|check_updates|install|rollback) ;; *) reply 0 'action_unknown'; exit 0;; esac
		lock || { reply 0 'operation_busy'; exit 0; }
		case "$name" in start|stop) action_settings "$name" || { unlock; reply 0 "$ERROR"; exit 0; };; esac
		if [ "$name" = install ]; then
			valid_tag "$revision" || { unlock; reply 0 version_invalid; exit 0; }
		fi
		queue_worker "$name" "$revision";;
	autostart)
		kind='' enabled=''
		read_request 1024 || { reply 0 'request_invalid'; exit 0; }
		json_get_type kind enabled
		json_get_var enabled enabled
		[ "$kind" = boolean ] || { reply 0 'enabled_invalid'; exit 0; }
		lock || { reply 0 'operation_busy'; exit 0; }
		trap 'unlock' EXIT
		if set_autostart "$enabled"; then
			reply 1 'autostart_updated'
		else
			reply 0 "$ERROR"
		fi;;
	geo)
		geosite_url='' geoip_url=''
		read_request 8192 || { reply 0 request_invalid; exit 0; }
		for key in geosite_url geoip_url; do
			json_get_type kind "$key"
			[ "$kind" = string ] || { reply 0 request_invalid; exit 0; }
		done
		json_get_var geosite_url geosite_url
		json_get_var geoip_url geoip_url
		for url in "$geosite_url" "$geoip_url"; do
			[ -z "$url" ] || valid_geo_url "$url" || { reply 0 geo_url_invalid; exit 0; }
		done
		lock || { reply 0 operation_busy; exit 0; }
		trap 'rm -f "$RUN/geo-request.json"; unlock' EXIT
		json_dump > "$RUN/geo-request.json" || { reply 0 geo_write_failed; exit 0; }
		queue_worker geo
		trap - EXIT
		exit 0;;
	preferences)
		proxy=''
		read_request 8192 || { reply 0 request_invalid; exit 0; }
		json_get_type kind proxy
		[ "$kind" = string ] || { reply 0 request_invalid; exit 0; }
		json_get_var proxy proxy
		valid_preferences "$proxy" || { reply 0 preferences_invalid; exit 0; }
		lock || { reply 0 operation_busy; exit 0; }
		trap 'unlock' EXIT
		if uci set honk.panel.proxy_prefix="$proxy"; then
			if uci commit honk; then reply 1 preferences_saved; else reply 0 preferences_failed; fi
		else reply 0 preferences_failed; fi;;
	*) reply 0 'method_unknown';;
esac
